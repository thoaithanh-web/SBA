    },
    {
      "name": "Deleted employee returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees/E900"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid sorting",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees?sort=unknown,asc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
