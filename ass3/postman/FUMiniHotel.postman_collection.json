        "url": "{{baseUrl}}/staff/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\"number\":\"{{roomB}}\",\"description\":\"Postman demo\",\"capacity\":2,\"typeId\":{{typeId}},\"pricePerDay\":200000,\"active\":true}",
