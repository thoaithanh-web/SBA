{
  "info": {
    "name": "ASS3 FU Mini Hotel",
    "description": "Lam Thoai Thanh - CE190169. Run in order against a local demo database. The runner creates sample records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083/api"
    },
    {
      "key": "staffEmail",
      "value": "staff@fuminihotel.local"
    },
    {
      "key": "staffPassword",
      "value": ""
    },
    {
      "key": "customerPassword",
      "value": "PostmanDemo123!"
    }
  ],
  "item": [
    {
      "name": "Guest lists active rooms",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/public/rooms"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.environment.get(\"runId\") || \"pm\" + Date.now().toString(36);",
              "pm.collectionVariables.set(\"customerEmail\", runId + \"@test.local\");",
              "pm.collectionVariables.set(\"roomA\", runId + \"-a\");",
              "pm.collectionVariables.set(\"roomB\", runId + \"-b\");",
              "const start = new Date(Date.now() + 2 * 86400000);",
              "const end = new Date(Date.now() + 4 * 86400000);",
              "pm.collectionVariables.set(\"start\", start.toISOString().slice(0, 10));",
              "pm.collectionVariables.set(\"end\", end.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only active rooms\", () => pm.expect(pm.response.json().every(room => room.active)).to.equal(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff route without token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/staff/rooms"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{staffEmail}}\", \"password\": \"{{staffPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "",
              "const session = pm.response.json();",
              "pm.test(\"Staff role\", () => pm.expect(session.role).to.equal(\"STAFF\"));",
              "pm.collectionVariables.set(\"staffToken\", session.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get room types",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/public/room-types"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"typeId\", pm.response.json()[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff creates room A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/staff/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\"number\":\"{{roomA}}\",\"description\":\"Postman demo\",\"capacity\":2,\"typeId\":{{typeId}},\"pricePerDay\":200000,\"active\":true}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"roomIdA\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff creates room B",
