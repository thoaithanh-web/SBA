{
  "info": {
    "name": "SBA301 Lab04 Orchid SQL Server API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "orchidId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryName\": \"Lab04 Postman Category\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"categoryId\", pm.response.json().categoryId);"
            ]
          }
        }
      ]
    },
    {
      "name": "List orchids",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create orchid",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orchids",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orchidName\": \"Cattleya Queen\",\n  \"isNatural\": true,\n  \"orchidDescription\": \"Lab04 Postman example\",\n  \"orchidCategory\": {\n    \"categoryId\": \"{{categoryId}}\"\n  },\n  \"isAttractive\": true,\n  \"orchidURL\": \"https://example.edu/orchid.svg\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"orchidId\", pm.response.json().orchidID);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read orchid",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids/{{orchidId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search orchids",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids?name=cattleya"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update orchid",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orchids/{{orchidId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orchidName\": \"Cattleya Updated\",\n  \"isNatural\": false,\n  \"orchidDescription\": \"Lab04 Postman example\",\n  \"orchidCategory\": {\n    \"categoryId\": \"{{categoryId}}\"\n  },\n  \"isAttractive\": true,\n  \"orchidURL\": \"https://example.edu/orchid.svg\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/orchids",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orchidName\": \"Cattleya Queen\",\n  \"isNatural\": true,\n  \"orchidDescription\": \"Lab04 Postman example\",\n  \"orchidCategory\": {\n    \"categoryId\": 9223372036854775807\n  },\n  \"isAttractive\": true,\n  \"orchidURL\": \"https://example.edu/orchid.svg\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Block linked category deletion",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete orchid",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/orchids/{{orchidId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted orchid returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/orchids/{{orchidId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete unused category",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}